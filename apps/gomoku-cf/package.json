{
	"name": "gomoku-cf",
	"description": "Gomoku game on Cloudflare Workers (React + Hono + Durable Objects + KV)",
	"private": true,
	"dependencies": {
		"@tailwindcss/vite": "^4.3.0",
		"hono": "4.11.1",
		"react": "19.2.1",
		"react-dom": "19.2.1",
		"tailwindcss": "^4.3.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.15.3",
		"@eslint/js": "9.39.1",
		"@types/node": "24.10.1",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "5.1.1",
		"@vitest/coverage-v8": "^4.1.7",
		"eslint": "9.39.2",
		"eslint-plugin-react-hooks": "7.0.1",
		"eslint-plugin-react-refresh": "0.4.24",
		"globals": "16.5.0",
		"typescript": "5.8.3",
		"typescript-eslint": "8.48.0",
		"vite": "^6.0.0",
		"wrangler": "4.56.0"
	},
	"scripts": {
		"build": "tsc -b && vite build",
		"cf-typegen": "wrangler types",
		"check": "tsc && vite build && wrangler deploy --dry-run",
		"deploy": "wrangler deploy",
		"dev": "vite",
		"lint": "eslint .",
		"preview": "npm run build && vite preview",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"type": "module"
}
